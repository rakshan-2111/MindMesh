# ============================================================================
# MindMesh Project - Root .gitignore
# ============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment & Sensitive Credentials
# Keep .env.example committed as a public template
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# ----------------------------------------------------------------------------
# Next.js Admin Web Dashboard
# ----------------------------------------------------------------------------
admin/node_modules/
admin/.next/
admin/out/
admin/build/
admin/coverage/
admin/*.tsbuildinfo
admin/npm-debug.log*
admin/yarn-debug.log*
admin/yarn-error.log*
admin/.pnpm-debug.log*

# ----------------------------------------------------------------------------
# Flutter Mobile App (Android & iOS)
# ----------------------------------------------------------------------------
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.pub/
mobile/.pub-cache/
mobile/build/
mobile/coverage/
mobile/.widget_preview/

# Android build outputs & local config
mobile/android/local.properties
mobile/android/.gradle/
mobile/android/app/build/
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/
mobile/android/captures/
mobile/android/.externalNativeBuild/

# iOS CocoaPods, framework caches & user schemes
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/App.framework
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/app.flx
mobile/ios/Flutter/app.zip
mobile/ios/Flutter/flutter_assets/
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/ServiceDefinitions.json
mobile/ios/Runner.xcworkspace/xcuserdata/
mobile/ios/Runner.xcodeproj/xcuserdata/
mobile/ios/Runner.xcodeproj/project.xcworkspace/xcuserdata/

# Desktop Ephemeral builds
mobile/macos/Flutter/ephemeral/
mobile/macos/Pods/
mobile/linux/flutter/ephemeral/
mobile/windows/flutter/ephemeral/

# ----------------------------------------------------------------------------
# IDE & Code Editor Metadata
# ----------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
